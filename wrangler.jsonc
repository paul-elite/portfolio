{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "vars": { "DEPLOYED": "1" },
  // the user's domain (the zone is on Cloudflare since 2026-11-26): Cloudflare makes the DNS records and
  // the certificates for custom domains itself
  // (with routes of its own a Worker loses its workers.dev address unless this says to keep it; the
  // avatar API and older links still use it)
  "workers_dev": true,
  "routes": [
    { "pattern": "paulelite.com", "custom_domain": true },
    { "pattern": "www.paulelite.com", "custom_domain": true },
    // the shop (Bachs payments), served by the same Worker: middleware.ts puts its pages at the root
    { "pattern": "shop.paulelite.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
